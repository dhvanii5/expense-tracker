# Docker compose ports
BACKEND_PORT=9002
FRONTEND_PORT=8080

# Frontend compile-time API base URL
# For local browser access, localhost works best.
VITE_API_BASE_URL=http://localhost:9002

# Llama server settings consumed by backend
# If you host llama-server elsewhere, replace the host/IP.
LLAMA_SERVER_URL=http://host.docker.internal:8080
LLAMA_SERVER_COMPLETIONS_URL=http://host.docker.internal:8080/completion
LLAMA_SERVER_EMBEDDINGS_URL=http://host.docker.internal:8080/embedding
LLAMA_SERVER_MODEL=qwen3b-dhvani-q8_0.gguf
